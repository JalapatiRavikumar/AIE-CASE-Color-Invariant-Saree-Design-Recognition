# Project settings — copy to .env and adjust
PROJECT_ROOT=.
API_HOST=0.0.0.0
API_PORT=8000
DEVICE=auto
BACKBONE=resnet18
EMBEDDING_DIM=256
IMAGE_SIZE=128
EPOCHS=12
BATCH_SIZE=32
LEARNING_RATE=0.0001
WEIGHT_DECAY=0.0001
TEMPERATURE=0.07
NUM_WORKERS=0
SEED=42
MAX_UPLOAD_MB=8
# Optional: override paths
# DATASET_RAW_DIR=backend/data/raw
# DATASET_PROCESSED_DIR=backend/data/processed
# GALLERY_DIR=backend/data/gallery
# MODELS_DIR=backend/models
# RESULTS_DIR=results
# DOWNLOADS_DIR=downloads
# Optional: set verification threshold (leave blank to use EER threshold)
# VERIFICATION_THRESHOLD=0.50
